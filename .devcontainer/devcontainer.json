{
  "name": "Daily News AI Digest & Generator (Codespaces Prebuild)",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11",
      "installTools": true
    }
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Application Dev Server & Briefing Viewer",
      "onAutoForward": "openPreview"
    }
  },
  "onCreateCommand": "bash .devcontainer/setup.sh",
  "updateContentCommand": "npm run build",
  "postCreateCommand": "echo 'Codespace environment prebuilt successfully! Run npm run dev to start.'",
  "customizations": {
    "vscode": {
      "settings": {
        "editor.formatOnSave": true,
        "typescript.tsdk": "node_modules/typescript/lib",
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      },
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-python.python",
        "formulahendry.auto-rename-tag"
      ]
    }
  },
  "remoteUser": "node"
}
